        "\n",
        "    /* SIDEBAR */\n",
        "    section[data-testid=\"stSidebar\"] {background-color: #0f1115; border-right: 1px solid #1e293b;}\n",
        "    .stat-box {background: #111827; border-left: 3px solid #3b82f6; padding: 10px; margin-bottom: 8px; border-radius: 4px;}\n",
        "    .stat-val {font-size: 0.95rem; font-weight: 700; color: #f3f4f6;}\n",
        "\n",
        "    .stButton>button {width: 100%; border-radius: 8px; font-weight: 600; height: 3rem; background: linear-gradient(90deg, #2563eb 0%, #1d4ed8 100%); border: none;}\n",
        "</style>\n",
        "\"\"\"\n",
        "st.markdown(STYLE_CSS, unsafe_allow_html=True)\n",
        "\n",
        "# ==============================================================================\n",
        "# 2. CAMADA DE DADOS (DATABASE & FILES)\n",
        "# ==============================================================================\n",
        "BASE_DIR = \"/content/drive/MyDrive/PRISMA_AI_WORKFLOW\"\n",
        "DIRS = {k: os.path.join(BASE_DIR, v) for k, v in {\"IN\":\"Entrada\", \"OUT\":\"Concluido\", \"REP\":\"Relatorios\"}.items()}\n",
        "for d in DIRS.values(): os.makedirs(d, exist_ok=True)\n",
        "\n",
        "# Estado da Sessão\n",
        "if 'logged_in' not in st.session_state: st.session_state.logged_in = False\n",
        "if 'data' not in st.session_state: st.session_state.data = None\n",
        "if 'chat_history' not in st.session_state: st.session_state.chat_history = []\n",
        "\n",
        "def init_db():\n",
        "    conn = sqlite3.connect(DB_FILE)\n",
        "    c = conn.cursor()\n",
        "    c.execute('''CREATE TABLE IF NOT EXISTS auditorias (\n",
        "        id INTEGER PRIMARY KEY AUTOINCREMENT, data TEXT, arquivo TEXT, campanha TEXT, modo TEXT,\n",
        "        nota REAL, resumo TEXT, tags TEXT, duracao REAL, checklist_json TEXT)''')\n",
        "    try: c.execute(\"SELECT checklist_json FROM auditorias LIMIT 1\")\n",
        "    except: c.execute(\"ALTER TABLE auditorias ADD COLUMN checklist_json TEXT\"); conn.commit()\n",
        "    conn.close()\n",
        "\n",
        "def db_save_audit(filename, nota, campanha, mode, resumo, tags, duration_sec=0, checklist_data=None):\n",
        "    conn = sqlite3.connect(DB_FILE); c = conn.cursor()\n",
        "    c.execute(\"SELECT id FROM auditorias WHERE arquivo = ?\", (filename,))\n",
        "    exists = c.fetchone()\n",
        "    checklist_str = json.dumps(checklist_data) if checklist_data else \"[]\"\n",
        "\n",
        "    if exists:\n",
        "        c.execute('''UPDATE auditorias SET nota=?, campanha=?, modo=?, resumo=?, tags=?, checklist_json=? WHERE arquivo=?''',\n",
        "                 (float(nota), campanha, mode, str(resumo)[:500], \",\".join(tags) if tags else \"\", checklist_str, filename))\n",
        "    else:\n",
        "        c.execute('''INSERT INTO auditorias (data, arquivo, campanha, modo, nota, resumo, tags, duracao, checklist_json) VALUES (?,?,?,?,?,?,?,?,?)''',\n",
        "                 (datetime.now().strftime(\"%Y-%m-%d %H:%M\"), str(filename), str(campanha), mode, float(nota), str(resumo)[:500], \",\".join(tags) if tags else \"\", round(duration_sec, 2), checklist_str))\n",
        "    conn.commit(); conn.close()\n",
        "\n",
        "def db_load_data():\n",
        "    conn = sqlite3.connect(DB_FILE)\n",
        "    try: return pd.read_sql_query(\"SELECT * FROM auditorias\", conn)\n",
        "    except: return pd.DataFrame()\n",
        "    finally: conn.close()\n",
        "\n",
        "init_db()\n",
        "\n",
        "# ==============================================================================\n",
        "# 3. CAMADA DE INTELIGÊNCIA (AI CORE)\n",
        "# ==============================================================================\n",
        "def get_ai_key():\n",
        "    if PROJECT_API_KEY and \"COLE_SUA\" not in PROJECT_API_KEY: return PROJECT_API_KEY\n",
        "    if os.path.exists(\"config_tokens.json\"):\n",
        "        try: return json.load(open(\"config_tokens.json\")).get(\"google_api_key\", \"\")\n",
        "        except: pass\n",
        "    return \"\"\n",
        "\n",
        "def ai_init():\n",
        "    key = get_ai_key()\n",
        "    if not key: return False\n",
        "    genai.configure(api_key=key)\n",
        "    return True\n",
        "\n",
        "@st.cache_resource\n",
        "def ai_load_whisper():\n",
        "    import torch\n",
        "    device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
        "    return WhisperModel(\"large-v3\", device=device, compute_type=\"float16\" if device==\"cuda\" else \"int8\")\n",
        "\n",
        "def ai_analyze_text(text, mode, keywords, custom_df):\n",
        "    rules_section = \"\"\n",
        "    # Personas e Prompt\n",
        "    if \"Upload\" in mode and custom_df is not None:\n",
        "        try:\n",
        "            custom_df.columns = [c.lower() for c in custom_df.columns]\n",
        "            col_map = {'critério': next((c for c in custom_df.columns if 'critério' in c), 'item')}\n",
        "            for _, row in custom_df.iterrows(): rules_section += f\"- {row[col_map['critério']]}\\n\"\n",
        "            role = f\"AUDITOR CUSTOMIZADO. Regras:\\n{rules_section}\"\n",
        "        except: return {\"nota\": 0, \"resumo\": \"Erro CSV\", \"checklist\": []}\n",
        "    else:\n",
        "        role = \"AUDITOR DE QUALIDADE SÊNIOR.\"\n",
        "\n",
        "    prompt = f\"\"\"{role} {f\"Busque: {keywords}\" if keywords else \"\"}\n",
        "\n",
        "    Analise a transcrição.\n",
        "    IMPORTANTE: Para cada item do checklist, tente estimar o tempo (mm:ss) onde ocorreu ou onde deveria ter ocorrido.\n",
        "\n",
        "    Retorne JSON:\n",
        "    {{\n",
        "        \"nota\": 0.0,\n",
        "        \"resumo\": \"...\",\n",
        "        \"palavras_chave\": [],\n",
        "        \"checklist\": [\n",
        "            {{\"categoria\": \"Técnica/Negocial/Humana\", \"item\": \"...\", \"status\": \"OK/NOK\", \"obs\": \"...\", \"tempo\": \"00:00\"}}\n",
        "        ],\n",
        "        \"pdca\": {{\"plan\": \"...\", \"do\": \"...\", \"check\": \"...\", \"act\": \"...\"}},\n",
        "        \"swot\": {{\"forcas\": [], \"fraquezas\": [], \"oportunidades\": [], \"ameacas\": []}},\n",
        "        \"feedback_gestor\": \"Texto direto e assertivo para o gestor dar o feedback ao agente, focado em melhoria.\"\n",
        "    }}\n",
        "    TXT: {text[:60000]}\"\"\"\n",
        "\n",
        "    try:\n",
        "        model = genai.GenerativeModel('models/gemini-2.5-flash')\n",
        "        res = model.generate_content(prompt)\n",
        "        clean = res.text.replace(\"```json\", \"\").replace(\"```\", \"\").strip()\n",
        "        return json.loads(clean[clean.find(\"{\"):clean.rfind(\"}\")+1])\n",
        "    except: raise Exception(\"Erro na Geração IA\")\n",
        "\n",
        "def util_generate_pdf(data, filename, campanha, mode):\n",
        "    pdf = FPDF()\n",
        "    pdf.add_page(); pdf.set_font(\"Arial\", \"B\", 16)\n",
        "    pdf.cell(0, 10, \"Relatorio PRISMA AI\", 0, 1, 'C')\n",
        "    pdf.set_font(\"Arial\", \"\", 12); pdf.ln(5)\n",
        "    def safe(txt): return str(txt).encode('latin-1', 'replace').decode('latin-1') if txt else \"\"\n",
        "    meta = [f\"Arquivo: {filename}\", f\"Campanha: {campanha}\", f\"Modo: {mode}\", f\"Nota: {data.get('nota',0)}\"]\n",
        "    for m in meta: pdf.cell(0, 8, safe(m), 0, 1)\n",
        "    pdf.ln(5); pdf.multi_cell(0, 6, f\"Resumo: {safe(data.get('resumo',''))}\")\n",
        "    pdf.ln(5); pdf.set_font(\"Arial\", \"B\", 10); pdf.cell(0, 8, \"Checklist Detalhado:\", 0, 1); pdf.set_font(\"Arial\", \"\", 9)\n",
        "    check = data.get('checklist_editable', data.get('checklist', []))\n",
        "    if isinstance(check, list):\n",
        "        for i in check:\n",
        "            stt = \"[OK]\" if (i.get('status')=='OK' or i.get('cumprido')) else \"[NOK]\"\n",
        "            tm = i.get('tempo', '')\n",
        "            pdf.multi_cell(0, 5, safe(f\"{tm} {stt} {i.get('item','')} - {i.get('obs','')}\"))\n",
        "\n",
        "    if 'feedback_gestor' in data:\n",
        "        pdf.ln(5); pdf.set_font(\"Arial\", \"B\", 10); pdf.cell(0, 8, \"Feedback ao Gestor:\", 0, 1); pdf.set_font(\"Arial\", \"\", 9)\n",
        "        pdf.multi_cell(0, 5, safe(data['feedback_gestor']))\n",
        "\n",
        "    fpath = f\"Relatorio_{int(time.time())}.pdf\"\n",
        "    pdf.output(fpath); return fpath\n",
        "\n",
        "# ==============================================================================\n",
        "# 4. COMPONENTES UI\n",
        "# ==============================================================================\n",
        "def render_sidebar():\n",
        "    with st.sidebar:\n",
        "        st.title(\"💎 PRISMA\"); st.caption(\"v3.1 Oficina CX\")\n",
        "        nav = st.radio(\"Menu\", [\"🏠 Dashboard\", \"🎧 Auditoria Manual\", \"🤖 Robô de Lote\", \"💬 Chat Intelligence\"])\n",
        "        st.markdown(\"---\")\n",
        "        df = db_load_data()\n",
        "        t_analises = len(df); t_custo = (df['duracao'].sum()/60) * COST_PER_MIN if not df.empty else 0.0\n",
        "        c1, c2 = st.columns(2)\n",
        "        c1.markdown(f\"<div class='stat-box'><div class='stat-title'>ANÁLISES</div><div class='stat-val'>{t_analises}</div></div>\", unsafe_allow_html=True)\n",
        "        c2.markdown(f\"<div class='stat-box'><div class='stat-title'>CUSTO EST.</div><div class='stat-val'>R$ {t_custo:.2f}</div></div>\", unsafe_allow_html=True)\n",
        "        if st.button(\"🧹 Limpar Banco\"): os.remove(DB_FILE); init_db(); st.rerun()\n",
        "        return nav\n",
        "\n",
        "# ==============================================================================\n",
        "# 5. PÁGINAS (CONTROLLERS)\n",
        "# ==============================================================================\n",
        "\n",
        "def page_dashboard():\n",
        "    df = db_load_data()\n",
        "    if df.empty:\n",
        "        st.markdown(\"<br><div style='text-align:center'><h1>👋 PRISMA v3.1</h1><p>Engine Pronta.</p></div>\", unsafe_allow_html=True)\n",
        "    else:\n",
        "        st.markdown(\"### 📊 Dashboard Executivo\")\n",
        "        k1, k2, k3 = st.columns(3)\n",
        "        media = df['nota'].mean()\n",
        "        k1.metric(\"Total\", len(df)); k2.metric(\"Média Geral\", f\"{media:.1f}\"); k3.metric(\"Críticos\", len(df[df['nota']<70]))\n",
        "        st.plotly_chart(px.area(df, x='data', y='nota', template=\"plotly_dark\"), use_container_width=True)\n",
        "\n",
        "def page_auditoria_manual():\n",
        "    st.markdown(\"### 🎧 Oficina de Qualidade CX\")\n",
        "\n",
        "    # 1. Configuração e Arquivos (Lado a Lado)\n",
        "    with st.expander(\"🛠️ Configuração & Central de Arquivos\", expanded=not st.session_state.data):\n",
        "        c_conf, c_file = st.columns([1, 1])\n",
        "        with c_conf:\n",
        "            camp = st.text_input(\"Campanha\", \"Campanha Padrão\")\n",
        "            mode = st.selectbox(\"Modo de Análise\", [\"Padrão\", \"Experiência do Cliente\", \"Retenção\", \"Upload Calibração\", \"Keywords\"])\n",
        "            custom_df = None; kws = \"\"\n",
        "            if \"Upload\" in mode:\n",
        "                f = st.file_uploader(\"Regras (CSV)\", key=\"rule_up\")\n",
        "                if f: custom_df = pd.read_csv(f) if f.name.endswith('.csv') else pd.read_excel(f)\n",
        "            if \"Keywords\" in mode: kws = st.text_input(\"Palavras-chave\")\n",
        "\n",
        "        with c_file:\n",
        "            f_up = st.file_uploader(\"Upload da Gravação (MP3/WAV)\", type=['mp3','wav','m4a','mp4'])\n",
        "            analyze_btn = st.button(\"⚡ INICIAR AUDITORIA\", type=\"primary\", disabled=not f_up)\n",
        "\n",
        "    # 2. Processamento com Status Visual\n",
        "    if analyze_btn and f_up:\n",
        "        if not ai_init(): st.error(\"Sem Chave IA\"); return\n",
        "\n",
        "        # STATUS DA AUDITORIA (Visualização do Processo)\n",
        "        with st.status(\"🕵️‍♂️ Oficina CX em ação...\", expanded=True) as status:\n",
        "            st.write(\"🎧 Transcrevendo áudio...\")\n",
        "            model = ai_load_whisper()\n",
        "            with open(\"temp\", \"wb\") as f: f.write(f_up.getbuffer())\n",
        "            seg, info = model.transcribe(\"temp\", language=\"pt\")\n",
        "            txt = \" \".join([s.text for s in seg])\n",
        "\n",
        "            st.write(\"🧠 Analisando Sondagem e Oferta...\")\n",
        "            d = ai_analyze_text(txt, mode, kws, custom_df)\n",
        "\n",
        "            st.write(\"📝 Gerando Feedback Assertivo...\")\n",
        "            d['text'] = txt; d['file'] = f_up.name; d['mode'] = mode\n",
        "\n",
        "            # Normalização Checklist\n",
        "            raw_check = d.get('checklist', [])\n",
        "            norm_check = []\n",
        "            for item in raw_check:\n",
        "                norm_check.append({\n",
        "                    \"Categoria\": item.get('categoria', 'Geral'),\n",
        "                    \"Item\": item.get('item', 'Item'),\n",
        "                    \"Status\": \"OK\" if (item.get('status')=='OK' or item.get('cumprido')) else \"NOK\",\n",
        "                    \"Obs\": item.get('obs', ''),\n",
        "                    \"Tempo\": item.get('tempo', '00:00')\n",
        "                })\n",
        "            d['checklist_editable'] = norm_check\n",
        "\n",
        "            db_save_audit(f_up.name, d.get('nota',0), camp, mode, d.get('resumo',''), d.get('palavras_chave',[]), info.duration, norm_check)\n",
        "            st.session_state.data = d\n",
        "            os.remove(\"temp\")\n",
        "            status.update(label=\"✅ Auditoria Finalizada!\", state=\"complete\", expanded=False)\n",
        "\n",
        "    # 3. Exibição dos Resultados (A \"Oficina\")\n",
        "    if st.session_state.data:\n",
        "        d = st.session_state.data\n",
        "        st.markdown(\"---\")\n",
        "\n",
        "        # HEADER: Resumo e Nota\n",
        "        c_res, c_nota = st.columns([3, 1])\n",
        "        with c_res:\n",
        "            st.markdown(f\"### 📋 Resumo da Interação\\n{d.get('resumo')}\")\n",
        "            # Downloads Rápidos\n",
