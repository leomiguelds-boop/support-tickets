        "\n",
        "# ==============================================================================\n",
        "# 1. CONSTANTES & CONFIGURAÇÃO GLOBAL\n",
        "# ==============================================================================\n",
        "PROJECT_API_KEY = \"AIzaSyCcOIEawbeSNt9X3jc3E2JWEda0FgsKxf0\" # ⚠️ INSIRA SUA CHAVE\n",
        "COST_PER_MIN = 0.50\n",
        "DB_FILE = \"prisma_core.db\"\n",
        "\n",
        "st.set_page_config(layout=\"wide\", page_title=\"PRISMA AI | Enterprise\", page_icon=\"💎\", initial_sidebar_state=\"expanded\")\n",
        "\n",
